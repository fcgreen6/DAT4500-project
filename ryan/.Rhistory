#packages and files
library(alarmdata)
library(redist)
library(dplyr)
library(ggplot2)
library(ggredist)
library(ggplot2)
library(patchwork) # for plotting
map_MO <- alarm_50state_map('MO')
map_MO <- map_MO |>
mutate(vote_tot = nrv + ndv)
map_MO2 = redist_map(map_MO, existing_plan=cd_2020, pop_tol=0.01,
total_pop = pop, adj = map_MO$adj)
MO_plans = redist_smc(map_MO2, nsims=500)
redist.plot.plans(MO_plans, draws=c("cd_2020", "1", "2", "3", "4", "5"), shp=map_MO2)
MO_plans = MO_plans |>
mutate(Compactness = comp_polsby(pl(), map_MO2),
`Population deviation` = plan_parity(map_MO2),
`Democratic vote` = group_frac(map_MO2, ndv, vote_tot))
#> Linking to GEOS 3.13.0, GDAL 3.8.5, PROJ 9.5.1; sf_use_s2() is TRUE
hist(MO_plans, `Population deviation`) + hist(MO_plans, Compactness) +
plot_layout(guides="collect") +
plot_annotation(title="Simulated plan characteristics")
redist.plot.scatter(MO_plans, `Population deviation`, Compactness) +
labs(title="Population deviation and compactness by plan")
plot(MO_plans, `Democratic vote`, size=0.5, color_thresh=0.5) +
scale_color_manual(values=c("black", "tomato2", "dodgerblue")) +
labs(title="Democratic vote share by district")
library(alarmdata)
library(redist)
library(dplyr)
library(ggplot2)
library(ggredist)
library(ggplot2)
library(sf)
library(patchwork) # for plotting..
map_NY <- alarm_50state_map('NY')
map_NY <- map_NY |>
mutate(vote_tot = nrv + ndv) |>
mutate(dem_perc = ndv / vote_tot)
southern_ny_counties <- c("New York County", "Kings County", "Queens County", "Bronx County", "Richmond County",
"Nassau County")
map_NY_south <- map_NY |>
filter(county %in% southern_ny_counties)
map_NY <- map_NY |>
filter(pop > 0) |>
mutate(
minority_pop = pop_hisp + pop_black + pop_aian + pop_asian + pop_nhpi + pop_other + pop_two,
minority_perc = ifelse(pop > 0, minority_pop / pop, NA))
southern_ny_counties <- c("New York County", "Kings County", "Queens County", "Bronx County", "Richmond County",
"Nassau County")
ggplot(map_NY_south) +
geom_sf(aes(fill = minority_perc), color = alpha("black", 0.1), linewidth = 0.01) +
scale_fill_gradient("Minority %",
low = "#FFFFE0", high = "grey",
labels = scales::percent,
na.value = "#EBEBEB")
southern_ny_counties <- c("New York County", "Kings County", "Queens County", "Bronx County", "Richmond County",
"Nassau County")
map_NY <- map_NY |>
filter(pop > 0) |>
mutate(
minority_pop = pop_hisp + pop_black + pop_aian + pop_asian + pop_nhpi + pop_other + pop_two,
minority_perc = ifelse(pop > 0, minority_pop / pop, NA))
