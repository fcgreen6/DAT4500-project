library(redist)
library(dplyr)
library(tigris)
library(sf)
library(tidycensus)
library(ggplot2)
# 1. Fetch Congressional District boundaries for Missouri (2022/current)
mo_districts <- congressional_districts(state = "MO", cb = TRUE, year = 2022) %>%
filter(DISTRICTNAT %in% c("04", "05", "06")) # Filter for Districts 4, 5, and 6
# 1. Fetch Congressional District boundaries for Missouri (2022/current)
mo_districts <- congressional_districts(state = "MO", cb = TRUE, year = 2022)
View(mo_districts)
mo_districts <- mo_districts |>
filter(CD118FP %in% c("04", "05", "06")) # Filter for Districts 4, 5, and 6
View(mo_districts)
# 2. Fetch Demographic Data (e.g., % Minority from ACS 5-year estimates)
# Note: Requires a Census API Key (census_api_key("YOUR_KEY"))
mo_demographics <- get_acs(
geography = "congressional district",
variables = c(total_pop = "B02001_001", white_pop = "B02001_002"),
state = "MO",
year = 2022,
geometry = TRUE
) |>
mutate(percent_minority = (1 - (estimate / first(estimate[variable == "white_pop"]))) * 100) |>
filter(GEOID %in% mo_districts$GEOID)
View(mo_demographics)
# 3. Define Political Data (Placeholder for CPVI or Election Results)
# Missouri District 4: R+21, District 5: D+12, District 6: R+19
mo_political <- mo_districts |>
mutate(cpvi_score = c(-21, 12, -19)) # Positive for Blue, Negative for Red
# --- Map 1: % Minority ---
map_minority <- ggplot(mo_demographics) +
geom_sf(aes(fill = percent_minority)) +
scale_fill_viridis_c(option = "mako", name = "% Minority") +
theme_minimal() +
labs(title = "Demographics: MO Districts 4, 5, 6")
View(mo_demographics)
