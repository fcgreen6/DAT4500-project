geom_sf(data = olddem_cd5,
fill = NA,
color = "red",
size = 1.2) +
scale_fill_gradient2(
low = "red",
mid = "white",
high = "blue",
midpoint = 0.5,
name = "Dem Share (2020)"
) +
labs(
title = "Precinct-Level Vote Share with New Districts",
subtitle = "Red = Old District 5, Black = New Districts"
) +
coord_sf(xlim = c(-95, -93), ylim = c(38.5, 40)) +  # KC zoom
theme_minimal()
mo_vtd_clip <- mo_vtd[st_intersects(mo_vtd, mo_new_subset, sparse = FALSE), ]
mo <- alarm_50state_map("MO")
mo <- mo %>%
mutate(
total = pre_20_dem + pre_20_rep,
dem_share = ifelse(total > 0, pre_20_dem / total, NA)
) %>%
filter(!is.na(dem_share))
mo <- alarm_50state_map("MO")
mo <- mo |>
mutate(
total = pre_20_dem_bid + pre_20_rep_tru,
dem_share = ifelse(total > 0, pre_20_dem_bid / total, NA)
) |>
filter(!is.na(dem_share))
mo_plans <- alarm_50state_plans("MO")
View(mo_plans)
plan_id <- mo_plans$draw[1]
plan_data <- mo_plans |>
filter(draw == plan_id)
mo$cd_new <- plan_data$district
